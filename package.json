{
  "name": "mikanra-game",
  "private": true,
  "version": "0.1.0",
  "description": "Learn practical Japanese through seven mornings running a neighborhood café.",
  "license": "UNLICENSED",
  "author": "Bryan",
  "repository": { "type": "git", "url": "https://github.com/flaune/mikanra-game.git" },
  "engines": { "node": ">=24 <25" },
  "type": "module",
  "scripts": {
    "rive": "node scripts/rive.cjs",
    "rive:preview": "node scripts/rive.cjs rive",
    "rive:verify": "node scripts/rive.cjs rive --verify",
    "rive:build": "node scripts/build-rive.cjs",
    "rive:inspect": "node scripts/rive.cjs inspect rive --summary",
    "dev": "vite",
    "prebuild": "node scripts/sync-rive.cjs",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "node scripts/test-e2e.cjs",
    "test:smoke": "node tests/browser/release-smoke.cjs",
    "audio:catalog": "node scripts/generate-pronunciation.cjs",
    "audio:arrival": "node scripts/generate-arrival.cjs",
    "licenses": "node scripts/collect-licenses.cjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@rive-app/canvas-lite": "^2.44.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.58.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "8.3.4"
  }
}
